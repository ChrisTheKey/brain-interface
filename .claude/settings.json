{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "voice": {
    "enabled": true,
    "mode": "hold",
    "autoSubmit": true
  },
  "voiceEnabled": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/zero-say.mjs --hook",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}

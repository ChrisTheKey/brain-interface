# ---------------------------------------------------------------------------
# Brain Interface — environment
#
# Copy to `.env.local` (git-ignored) and adjust. No secrets belong in here:
# ZERO owns every upstream credential (model provider, MCP servers, voice).
# ---------------------------------------------------------------------------

# WebSocket endpoint of the ZERO app-server.
# Start ZERO with:  codex app-server --listen ws://127.0.0.1:8787
VITE_ZERO_WS_URL=ws://127.0.0.1:8787

# Client identity reported to ZERO during `initialize`.
VITE_ZERO_CLIENT_NAME=brain_interface
VITE_ZERO_CLIENT_VERSION=0.1.0

# Opt into ZERO's experimental API surface. Required for thread realtime
# (ZERO voice). Structural data works without it.
VITE_ZERO_EXPERIMENTAL_API=true

# Extra workspace roots to scan for skills (knowledge bases), comma separated.
# Workspaces of existing ZERO threads are added automatically.
VITE_ZERO_CWDS=

# How many threads to request per source kind (agents + sub-agents).
VITE_ZERO_THREAD_LIMIT=40

# Structural refresh interval in ms (live changes arrive over notifications).
VITE_ZERO_REFRESH_INTERVAL_MS=20000

# Fullscreen background asset (see README → Background asset).
VITE_ZERO_BACKGROUND_IMAGE=/reference/red-background.jpg

# Voice provider: zero-realtime | speech-synthesis | none
VITE_ZERO_VOICE_PROVIDER=zero-realtime
# Ordered, comma separated substrings matched against the platform voice list
# (only used by the speech-synthesis fallback).
VITE_ZERO_VOICE_NAMES=
VITE_ZERO_VOICE_RATE=0.92
VITE_ZERO_VOICE_PITCH=0.82
VITE_ZERO_VOICE_VOLUME=1
# Speak ZERO's completed agent messages automatically.
VITE_ZERO_VOICE_SPEAK_AGENT_MESSAGES=false

# Session prompt that defines ZERO's voice character for the realtime provider.
# Leave empty to use the built-in ZERO persona (see src/voice/provider.ts).
VITE_ZERO_VOICE_PROMPT=

# ---------------------------------------------------------------------------
# Agent network
# ---------------------------------------------------------------------------

# Directory that holds your agent repositories. ZERO scans it (read-only,
# through `command/exec`) and classifies each repository; only repositories
# that are really agents become agent nodes.
VITE_ZERO_AGENT_ROOT=

# Optional manifest that adds id/role/capabilities/inputs/outputs per agent.
# Defaults to <VITE_ZERO_AGENT_ROOT>/zero-agents.json.
VITE_ZERO_AGENT_MANIFEST=

# Sandbox policy for the discovery command: readOnly (default) |
# externalSandbox (only when the host already sandboxes ZERO) | workspaceWrite
VITE_ZERO_EXEC_SANDBOX=readOnly

# Sandbox mode for the threads ZERO starts in an agent workspace.
VITE_ZERO_AGENT_SANDBOX=read-only

# Working directory for ZERO's routing thread (defaults to the agent root).
VITE_ZERO_ORCHESTRATOR_CWD=

# Timeouts for one agent run and for ZERO's routing decision.
VITE_ZERO_AGENT_TIMEOUT_MS=180000
VITE_ZERO_ROUTE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Speech input (microphone → speech-to-text → ZERO)
# ---------------------------------------------------------------------------

# web-speech (browser SpeechRecognition, no credentials) | none
VITE_ZERO_SPEECH_PROVIDER=web-speech
VITE_ZERO_SPEECH_LANGUAGE=de-DE

# ---------------------------------------------------------------------------
# ZERO Gateway (one origin for laptop and phone)
# ---------------------------------------------------------------------------

# Port the gateway serves the interface, /api and /ws on. Hard requirement: 3000.
ZERO_UI_PORT=3000

# HWD-ZERO's internal API. Stays on loopback — never exposed to the LAN.
ZERO_API_URL=http://127.0.0.1:8000

# Bind the gateway to 0.0.0.0 so the Samsung Galaxy can reach it. Off by default.
ZERO_LAN_MODE=false

# Where the generated access token is stored (0600, outside the bundle).
ZERO_TOKEN_FILE=.zero/gateway-token

# Requests per minute per client address.
ZERO_RATE_LIMIT=240

# ---------------------------------------------------------------------------
# Termux / Android (Galaxy S25 Ultra) — see docs/TERMUX_GALAXY_S25.md
#
# On the phone itself none of these normally need changing: the workspace is
# detected and the gateway binds both loopback families so that the browser's
# http://localhost:3000 resolves either way.
# ---------------------------------------------------------------------------

# Directory holding HWD-ZERO and brain-interface. Empty = detect it (walk up
# from this checkout, then $HOME/ZERO-WORKSPACE). No user name is ever assumed.
ZERO_WORKSPACE=

# Bind 127.0.0.1 only. Set this if the device has no IPv6 loopback and the
# ::1 bind is producing noise in the startup banner.
ZERO_DISABLE_IPV6=false

# V8 old-space ceiling (MB) for `npm run build`. Lower it on a device under
# memory pressure.
ZERO_BUILD_HEAP_MB=2048

# Skip `pkg install` during scripts/setup-termux.sh (packages already present).
ZERO_SKIP_PKG=false

# ---------------------------------------------------------------------------
# Brain Interface — environment
#
# Copy to `.env.local` (git-ignored) and adjust. No secrets belong in here:
# ZERO owns every upstream credential (model provider, MCP servers, voice).
# ---------------------------------------------------------------------------

# WebSocket endpoint of the ZERO app-server.
# Start ZERO with:  codex app-server --listen ws://127.0.0.1:8787
VITE_ZERO_WS_URL=ws://127.0.0.1:8787

# Client identity reported to ZERO during `initialize`.
VITE_ZERO_CLIENT_NAME=brain_interface
VITE_ZERO_CLIENT_VERSION=0.1.0

# Opt into ZERO's experimental API surface. Required for thread realtime
# (ZERO voice). Structural data works without it.
VITE_ZERO_EXPERIMENTAL_API=true

# Extra workspace roots to scan for skills (knowledge bases), comma separated.
# Workspaces of existing ZERO threads are added automatically.
VITE_ZERO_CWDS=

# How many threads to request per source kind (agents + sub-agents).
VITE_ZERO_THREAD_LIMIT=40

# Structural refresh interval in ms (live changes arrive over notifications).
VITE_ZERO_REFRESH_INTERVAL_MS=20000

# Fullscreen background asset (see README → Background asset).
VITE_ZERO_BACKGROUND_IMAGE=/reference/red-background.jpg

# Voice provider: zero-realtime | fish-audio | speech-synthesis | none
# Whichever one is set is tried first; the others stay behind it as fallbacks
# and each decides for itself whether it can run here.
VITE_ZERO_VOICE_PROVIDER=zero-realtime
# Ordered, comma separated substrings matched against the platform voice list
# (only used by the speech-synthesis fallback).
VITE_ZERO_VOICE_NAMES=
VITE_ZERO_VOICE_RATE=0.92
VITE_ZERO_VOICE_PITCH=0.82
VITE_ZERO_VOICE_VOLUME=1
# Speak ZERO's completed agent messages automatically.
VITE_ZERO_VOICE_SPEAK_AGENT_MESSAGES=false

# Session prompt that defines ZERO's voice character for the realtime provider.
# Leave empty to use the built-in ZERO persona (see src/voice/provider.ts).
VITE_ZERO_VOICE_PROMPT=

# ---------------------------------------------------------------------------
# Fish Audio (voice)
#
# The API key is a *gateway* variable, further down — it must never reach the
# browser bundle. Everything here only describes which voice to ask for.
# ---------------------------------------------------------------------------

# Gateway endpoint that proxies Fish Audio. Same origin; no credential.
VITE_ZERO_FISH_ENDPOINT=/api/voice/fish
# Fish Audio voice model ("reference id"). Empty uses the model's own speaker.
# Pick one at https://fish.audio/ — the gateway can list them at
# /api/voice/fish/voices once the key is set.
VITE_ZERO_FISH_VOICE_ID=
VITE_ZERO_FISH_MODEL=s2.1-pro
# normal | balanced | low — low is fastest to first sound.
VITE_ZERO_FISH_LATENCY=balanced
# pcm goes through the Web Audio graph, which is what makes the smoke react.
# mp3/wav/opus work too, but have to be decoded as a whole clip first.
VITE_ZERO_FISH_FORMAT=pcm
VITE_ZERO_FISH_SAMPLE_RATE=44100
# Prosody speed, 0.5–2.0. ZERO speaks a little below neutral.
VITE_ZERO_FISH_SPEED=0.94

# ---------------------------------------------------------------------------
# Voice mode (/voice)
# ---------------------------------------------------------------------------

# Keep listening after ZERO has answered, so the conversation continues
# without touching the machine. Off means one turn per click.
VITE_ZERO_VOICE_MODE_CONTINUOUS=true
# Pause between ZERO finishing and the microphone re-opening.
VITE_ZERO_VOICE_MODE_RESTART_MS=600
# Start listening as soon as /voice is opened.
VITE_ZERO_VOICE_MODE_AUTOSTART=false

# ---------------------------------------------------------------------------
# Agent network
# ---------------------------------------------------------------------------

# Directory that holds your agent repositories. ZERO scans it (read-only,
# through `command/exec`) and classifies each repository; only repositories
# that are really agents become agent nodes.
VITE_ZERO_AGENT_ROOT=

# Optional manifest that adds id/role/capabilities/inputs/outputs per agent.
# Defaults to <VITE_ZERO_AGENT_ROOT>/zero-agents.json.
VITE_ZERO_AGENT_MANIFEST=

# Sandbox policy for the discovery command: readOnly (default) |
# externalSandbox (only when the host already sandboxes ZERO) | workspaceWrite
VITE_ZERO_EXEC_SANDBOX=readOnly

# Sandbox mode for the threads ZERO starts in an agent workspace.
VITE_ZERO_AGENT_SANDBOX=read-only

# Working directory for ZERO's routing thread (defaults to the agent root).
VITE_ZERO_ORCHESTRATOR_CWD=

# Timeouts for one agent run and for ZERO's routing decision.
VITE_ZERO_AGENT_TIMEOUT_MS=180000
VITE_ZERO_ROUTE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Speech input (microphone → speech-to-text → ZERO)
# ---------------------------------------------------------------------------

# web-speech (browser SpeechRecognition, no credentials) | none
VITE_ZERO_SPEECH_PROVIDER=web-speech
VITE_ZERO_SPEECH_LANGUAGE=de-DE

# ---------------------------------------------------------------------------
# ZERO Gateway (one origin for laptop and phone)
# ---------------------------------------------------------------------------

# Port the gateway serves the interface, /api and /ws on. Hard requirement: 3000.
ZERO_UI_PORT=3000

# HWD-ZERO's internal API. Stays on loopback — never exposed to the LAN.
ZERO_API_URL=http://127.0.0.1:8000

# Bind the gateway to 0.0.0.0 so the Samsung Galaxy can reach it. Off by default.
ZERO_LAN_MODE=false

# Where the generated access token is stored (0600, outside the bundle).
ZERO_TOKEN_FILE=.zero/gateway-token

# Requests per minute per client address.
ZERO_RATE_LIMIT=240

# Largest JSON body the gateway's own endpoints accept.
ZERO_MAX_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Fish Audio credential (gateway only)
#
# This is the one secret in this file, and it lives in `.env.local`, which is
# git-ignored. It is read by the gateway process and never sent to the browser:
# the interface posts text to its own origin and gets audio back.
# ---------------------------------------------------------------------------

# https://fish.audio/ → API keys. Empty disables the Fish Audio voice.
FISH_AUDIO_API_KEY=
FISH_AUDIO_API_URL=https://api.fish.audio
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_FORMAT=pcm
FISH_AUDIO_SAMPLE_RATE=44100
FISH_AUDIO_SPEED=0.94
FISH_AUDIO_VOLUME=0
FISH_AUDIO_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Browser bridge — ZERO's access to the internet
#
# The gateway drives a browser that is really installed on this machine:
# Chrome, Firefox, Brave or Edge. ZERO reaches it as an MCP server
# (`mcp/brain-browser-server.mjs`), the interface shows its status.
# ---------------------------------------------------------------------------

# Browser used when a request does not name one: chrome | firefox | brave | edge
ZERO_BROWSER=chrome
VITE_ZERO_BROWSER=chrome
VITE_ZERO_BROWSER_ENDPOINT=/api/browser

# Run the browser without a window.
ZERO_BROWSER_HEADLESS=false

# Pin an executable the standard locations do not cover (a portable build, a
# Flatpak wrapper, a container image).
ZERO_BROWSER_CHROME_PATH=
ZERO_BROWSER_FIREFOX_PATH=
ZERO_BROWSER_BRAVE_PATH=
ZERO_BROWSER_EDGE_PATH=

# DANGER. A browser on this machine can reach this machine — HWD-ZERO on
# :8000, the gateway on :3000, Ollama, every child agent. The bridge therefore
# refuses loopback, link-local and private addresses, and refuses a public name
# that resolves to one. Only turn this off if you know exactly why.
ZERO_BROWSER_ALLOW_PRIVATE=false

# Chromium refuses to start its own sandbox as root (containers, CI). Turning
# it off is a real security downgrade; it is never the default.
ZERO_BROWSER_NO_SANDBOX=false

# Close the browser after this long without a request. 0 keeps it open.
ZERO_BROWSER_IDLE_MS=300000
ZERO_BROWSER_NAV_TIMEOUT_MS=30000
# Maximum characters of page text handed back per read.
ZERO_BROWSER_MAX_CHARS=12000
# duckduckgo | google | bing | brave
ZERO_BROWSER_SEARCH_ENGINE=duckduckgo

# The MCP server reaches the bridge through the gateway on loopback.
ZERO_GATEWAY_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------

# `npm run dev` is a bare Vite server, so /api has no backend. Point this at a
# gateway on another port to get the operator panel, Fish Audio and the browser
# bridge while developing:
#     ZERO_UI_PORT=3001 npm run gateway
#     ZERO_DEV_API_PROXY=http://127.0.0.1:3001 npm run dev
ZERO_DEV_API_PROXY=

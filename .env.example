# ---------------------------------------------------------------------------
# Brain Interface — environment
#
# Copy to `.env.local` (git-ignored) and adjust. No secrets belong in here:
# ZERO owns every upstream credential (model provider, MCP servers, voice).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# There is deliberately no VITE_ZERO_WS_URL any more.
#
# Every `VITE_*` value is compiled into the bundle the browser downloads, and
# a backend address there is wrong on every device but the one running ZERO:
# `127.0.0.1` means *this device*, so on the Samsung Galaxy it points the phone
# at the phone. The interface now derives `/api` and `/ws` from the origin that
# served it. The internal addresses live below, under ZERO Gateway — read by
# the gateway process, never by the browser.
# ---------------------------------------------------------------------------

# Client identity reported to ZERO during `initialize`.
VITE_ZERO_CLIENT_NAME=brain_interface
VITE_ZERO_CLIENT_VERSION=0.1.0

# Opt into ZERO's experimental API surface. Required for thread realtime
# (ZERO voice). Structural data works without it.
VITE_ZERO_EXPERIMENTAL_API=true

# Extra workspace roots to scan for skills (knowledge bases), comma separated.
# Workspaces of existing ZERO threads are added automatically.
VITE_ZERO_CWDS=

# How many threads to request per source kind (agents + sub-agents).
VITE_ZERO_THREAD_LIMIT=40

# Structural refresh interval in ms (live changes arrive over notifications).
VITE_ZERO_REFRESH_INTERVAL_MS=20000

# Fullscreen background asset (see README → Background asset).
VITE_ZERO_BACKGROUND_IMAGE=/reference/red-background.jpg

# Voice provider: zero-realtime | speech-synthesis | none
VITE_ZERO_VOICE_PROVIDER=zero-realtime
# Ordered, comma separated substrings matched against the platform voice list
# (only used by the speech-synthesis fallback).
VITE_ZERO_VOICE_NAMES=
VITE_ZERO_VOICE_RATE=0.92
VITE_ZERO_VOICE_PITCH=0.82
VITE_ZERO_VOICE_VOLUME=1
# Speak ZERO's completed agent messages automatically.
VITE_ZERO_VOICE_SPEAK_AGENT_MESSAGES=false

# Session prompt that defines ZERO's voice character for the realtime provider.
# Leave empty to use the built-in ZERO persona (see src/voice/provider.ts).
VITE_ZERO_VOICE_PROMPT=

# ---------------------------------------------------------------------------
# Agent network
# ---------------------------------------------------------------------------

# Directory that holds your agent repositories. ZERO scans it (read-only,
# through `command/exec`) and classifies each repository; only repositories
# that are really agents become agent nodes.
VITE_ZERO_AGENT_ROOT=

# Optional manifest that adds id/role/capabilities/inputs/outputs per agent.
# Defaults to <VITE_ZERO_AGENT_ROOT>/zero-agents.json.
VITE_ZERO_AGENT_MANIFEST=

# Sandbox policy for the discovery command: readOnly (default) |
# externalSandbox (only when the host already sandboxes ZERO) | workspaceWrite
VITE_ZERO_EXEC_SANDBOX=readOnly

# Sandbox mode for the threads ZERO starts in an agent workspace.
VITE_ZERO_AGENT_SANDBOX=read-only

# Working directory for ZERO's routing thread (defaults to the agent root).
VITE_ZERO_ORCHESTRATOR_CWD=

# Timeouts for one agent run and for ZERO's routing decision.
VITE_ZERO_AGENT_TIMEOUT_MS=180000
VITE_ZERO_ROUTE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Speech input (microphone → speech-to-text → ZERO)
# ---------------------------------------------------------------------------

# web-speech (browser SpeechRecognition, no credentials) | none
VITE_ZERO_SPEECH_PROVIDER=web-speech
VITE_ZERO_SPEECH_LANGUAGE=de-DE

# ---------------------------------------------------------------------------
# ZERO Gateway (one origin for laptop and phone)
# ---------------------------------------------------------------------------

# Port the gateway serves the interface, /api and /ws on. Hard requirement: 3000.
ZERO_UI_PORT=3000

# HWD-ZERO's internal HTTP API. Stays on loopback — never exposed to the LAN,
# never compiled into the bundle. The gateway proxies /api/* here.
ZERO_API_URL=http://127.0.0.1:8000

# ZERO's runtime app-server socket. A separate value because it is a separate
# process on a separate port (`codex app-server --listen ws://IP:PORT`). The
# gateway proxies the public /ws here; /ws/events goes to ZERO_API_URL.
# Verify both against your deployment — do not assume either port.
ZERO_RUNTIME_WS_URL=ws://127.0.0.1:8787

# Command that starts HWD-ZERO's API, run inside ZERO_RUNTIME_DIR by
# scripts/zero-go.sh. Empty means "I start HWD-ZERO myself"; the interface
# then reports BACKEND OFFLINE until it is up.
ZERO_START_CMD=

# Where HWD-ZERO is checked out. Defaults to the sibling directory of this
# repository, whichever capitalisation it uses.
ZERO_RUNTIME_DIR=

# Include internal upstream addresses in /api/health. On by default for local
# development, off by default in LAN mode.
ZERO_DIAGNOSTICS=

# Bind the gateway to 0.0.0.0 so the Samsung Galaxy can reach it. Off by default.
ZERO_LAN_MODE=false

# Where the generated access token is stored (0600, outside the bundle).
ZERO_TOKEN_FILE=.zero/gateway-token

# Requests per minute per client address.
ZERO_RATE_LIMIT=240

# ---------------------------------------------------------------------------
# ZERO's voice (text to speech)
#
# Read by the gateway process, never by the browser. There is deliberately no
# VITE_ variant of any of this: a VITE_ value is compiled into the bundle the
# browser downloads, and an API key in a bundle is an API key published.
#
# Off by default. A checkout that happens to inherit a key in its environment
# should not start sending ZERO's answers to a third party.
# ---------------------------------------------------------------------------
FISH_AUDIO_ENABLED=false

# Your own Fish Audio key. Never commit this — .env.local is git-ignored.
FISH_API_KEY=

# The free tier, as of writing. Named rather than assumed permanent: when the
# provider stops accepting it, ZERO reports FREE MODEL UNAVAILABLE and falls
# back. It never quietly upgrades to a model that bills.
FISH_AUDIO_MODEL=s2.1-pro-free

# A public Fish Audio voice. These two were confirmed against the live model
# API as public and trained; neither was created, cloned or uploaded by this
# project, and both declare English only in their metadata.
#   306c68e5763b42d6b06fe0380daa5281  Lelouch Vi Britannia (Universal)
#   349b7618384141f780d21e119624783f  Lelouch (Jatteks)
FISH_AUDIO_VOICE_ID=306c68e5763b42d6b06fe0380daa5281
FISH_AUDIO_VOICE_NAME=Lelouch Vi Britannia

# Seconds to wait before giving up and using the local voice instead.
FISH_AUDIO_TIMEOUT_MS=20000

ZERO_TTS_PROVIDER=fish_audio
ZERO_TTS_FALLBACK=browser

# The strongest switch here. With this on, no cloud voice is called at all,
# even with a key present and a provider configured.
ZERO_LOCAL_ONLY=false

# ---------------------------------------------------------------------------
# ZERO reading the public web
#
# Read by HWD-ZERO, which is what does the fetching — the gateway proxies
# /api/web/* to it like every other route. Off by default: reading the
# internet tells whoever is on the other end that this machine asked, and a
# page ZERO reads is a page that can try to talk it into something.
#
# Only public http and https, only documents, no cookies and no credentials.
# Every hop — including each redirect — is resolved and checked against the
# address it lands on, so ZERO cannot be talked into fetching ZERO.
# ---------------------------------------------------------------------------
ZERO_WEB_ENABLED=false

# Narrow it further if you want. Empty allow list means "any public host";
# deny always wins, and a subdomain of a listed host counts as listed.
ZERO_WEB_ALLOW=
ZERO_WEB_DENY=
ZERO_WEB_TIMEOUT=15

# Reading a URL you name needs no provider. *Finding* one does.
#   searxng  — self-hosted, no key: set ZERO_WEB_SEARCH_URL
#   brave    — needs ZERO_WEB_SEARCH_KEY
#   tavily   — needs ZERO_WEB_SEARCH_KEY
ZERO_WEB_SEARCH=none
ZERO_WEB_SEARCH_URL=
ZERO_WEB_SEARCH_KEY=

# ---------------------------------------------------------------------------
# ZERO driving a real browser
#
# For pages that render themselves in JavaScript, which the reader above
# cannot see. Read by the gateway, because Playwright cannot live in HWD-ZERO
# — that keeps one runtime dependency so it stays installable on a phone. A
# phone has no desktop browser to drive either, so this is desktop-only and
# says so rather than failing quietly.
#
# The browser gets its own profile and never yours. A browser holding your
# sessions is a browser that acts as you. Each browser gets its own directory
# underneath, so Firefox never reads what Chrome was logged into.
# ---------------------------------------------------------------------------
ZERO_BROWSER_ENABLED=false

# Which browser to open by default. One of:
#   chrome    the Google Chrome already installed          (nothing to download)
#   edge      the Microsoft Edge already installed         (nothing to download)
#   brave     the Brave already installed, found by path   (nothing to download)
#   firefox   Playwright's own Firefox                     (npx playwright install firefox)
#   chromium  Playwright's own Chromium                    (npx playwright install chromium)
#
# Firefox is the one that cannot use your installed copy: Playwright drives a
# patched build, so a stock Firefox is not driveable and ZERO says so instead
# of pretending. Any of them can still be picked per request.
ZERO_BROWSER=chrome

# Where that browser is, if it is somewhere unusual. Brave is found this way on
# machines that installed it outside the normal location.
ZERO_BROWSER_PATH=

# ZERO's own profile root; one subdirectory per browser.
# Delete the directory to forget everything it did.
ZERO_BROWSER_PROFILE=

# Watch it work. Off means headless.
ZERO_BROWSER_HEADFUL=false
ZERO_BROWSER_IDLE_MS=300000
ZERO_BROWSER_TIMEOUT_MS=30000

# Chromium does not read the shell's proxy variables. Defaults to HTTPS_PROXY.
ZERO_BROWSER_PROXY=

# ---------------------------------------------------------------------------
# ZERO publishing: Metricool MCP
#
# Read by HWD-ZERO, not by this gateway and never by the browser. The gateway
# proxies /api/integrations/metricool/* to the runtime like everything else;
# the credential lives in the runtime's vault and no token is ever in a
# response body, a bundle or a log.
#
# There is nothing to paste here. Press CONNECT METRICOOL in the interface,
# sign in, and the OAuth flow stores an encrypted token in ~/.zero/secrets.json.
# ---------------------------------------------------------------------------

# The official hosted MCP server. Set only to point at a different deployment.
ZERO_METRICOOL_MCP=https://ai.metricool.com/mcp

# false switches the integration off entirely.
ZERO_METRICOOL_ENABLED=true

# Where Metricool sends the browser back. Must match what was registered —
# which ZERO does for you on first connect. Change it if the gateway is not
# on 127.0.0.1:3000.
ZERO_METRICOOL_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/metricool/callback

# Skip dynamic client registration and use a client you registered yourself.
ZERO_METRICOOL_CLIENT_ID=

# Hold the vault key yourself instead of letting ZERO keep it in
# ~/.zero/vault.key. 32 bytes, base64.
ZERO_VAULT_KEY=

# Permit an MCP server on a private address — a self-hosted one on your LAN.
# Off by default: a client that may dial 127.0.0.1 with a bearer token attached
# has reached past every gate in the system.
ZERO_MCP_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# ZERO managing paid advertising: Meta's official Ads MCP
#
# Read by HWD-ZERO, not by this gateway and never by the browser. There is
# nothing to paste here — press CONNECT META ADS in the interface, sign in with
# Meta Business, and the encrypted vault holds the token.
#
# Reading an ad account is autonomous. Anything that can spend stops at an
# approval bound to the exact payload — and under the ceilings below, which no
# approval clears.
# ---------------------------------------------------------------------------

ZERO_META_ADS_ENABLED=true

# Meta's official hosted server. Set only to point at a different deployment.
ZERO_META_ADS_MCP=https://mcp.facebook.com/ads

# Where Meta sends the browser back. Change it if the gateway is not on
# 127.0.0.1:3000.
ZERO_META_ADS_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/meta-ads/callback

# Skip dynamic client registration and use a client you registered yourself.
ZERO_META_ADS_CLIENT_ID=

# Which ad account to use when the login reaches several. Empty means ZERO
# asks rather than choosing one at random — it is somebody's money.
ZERO_META_ADS_ACCOUNT=

# ---------------------------------------------------------------------------
# Spend ceilings.
#
# These are the one limit an approval cannot lift. They are checked below the
# reasoning, so no sentence — from the model, from you over voice, from a page
# ZERO read — raises one. Changing a ceiling means editing this file and
# restarting, which is the right amount of friction for a spending limit.
#
# Unset does NOT mean unlimited: every spend still stops at you. It means no
# ceiling bounds how much a single approval can cost.
#
# Amounts are in your account's currency, as you would write them.
# ---------------------------------------------------------------------------

META_ADS_MAX_DAILY_BUDGET=
META_ADS_MAX_LIFETIME_BUDGET=

# How far one change may raise a budget that is already running. The dangerous
# mutation is rarely a big new campaign — it is 30 becoming 300 on something
# already delivering, which reads almost identically in an approval.
META_ADS_MAX_SINGLE_MUTATION_INCREASE_PERCENT=

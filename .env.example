# ---------------------------------------------------------------------------
# ZERO Brain Interface — environment
#
# Copy to `.env.local` (git-ignored). There are no secrets here and no backend
# address: HWD-ZERO owns every credential and the gateway is the only origin
# the browser ever talks to. Everything below is presentation and local voice
# tuning.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Interface
# ---------------------------------------------------------------------------

# Leave empty for same-origin (the normal case: the gateway serves this app).
# Only set it when the Vite dev server and the gateway run on different ports.
VITE_ZERO_API_BASE=

# Fullscreen background plate (see README → The plate).
VITE_ZERO_BACKGROUND_IMAGE=/reference/red-background.jpg

# How often the operator's lists are re-read. Live changes still arrive on
# /ws/events; this is the correction after a reconnect or a sleeping phone.
VITE_ZERO_REFRESH_INTERVAL_MS=10000

# Reconnect backoff for /ws/events and /ws/voice.
VITE_ZERO_RECONNECT_DELAY_MS=2000

# ---------------------------------------------------------------------------
# Speech input (microphone → speech-to-text → HWD-ZERO)
# ---------------------------------------------------------------------------

# web-speech (browser SpeechRecognition, no credentials) | none
VITE_ZERO_SPEECH_PROVIDER=web-speech
VITE_ZERO_SPEECH_LANGUAGE=de-DE

# ---------------------------------------------------------------------------
# Voice output
#
#   auto      the best real-audio path HWD-ZERO actually offers  (default)
#   stream    PCM16 frames on /ws/voice — measured, the intended path
#   http      POST /api/voice/tts — measured, not streamed
#   synthesis the browser voice — no audio graph, reaction is ESTIMATED
#   none      text only
# ---------------------------------------------------------------------------

VITE_ZERO_VOICE_MODE=auto

# Speak ZERO's answer as soon as it arrives.
VITE_ZERO_VOICE_AUTOSPEAK=true

# Only used by the browser-synthesis fallback: ordered, comma separated
# substrings matched against the platform voice list, and the voice character.
VITE_ZERO_VOICE_NAMES=
VITE_ZERO_VOICE_RATE=0.92
VITE_ZERO_VOICE_PITCH=0.82
VITE_ZERO_VOICE_VOLUME=1

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

# auto (measure the device, then correct from real frame times) | low | medium | high
VITE_ZERO_RENDER_QUALITY=auto

# Upper bound for the device pixel ratio. Lower it on a very dense panel.
VITE_ZERO_MAX_PIXEL_RATIO=2

# Allow the (limited) bloom pass. It only ever runs on the high tier.
VITE_ZERO_BLOOM=true

# Ceiling for the smoke particle pool; the quality tier scales down from here.
VITE_ZERO_MAX_SMOKE_PARTICLES=900

# ---------------------------------------------------------------------------
# ZERO Gateway (one origin for laptop and phone)
# ---------------------------------------------------------------------------

# Port the gateway serves the interface, /api and /ws on. Hard requirement: 3000.
ZERO_UI_PORT=3000

# HWD-ZERO's internal API. Stays on loopback — never exposed to the LAN.
ZERO_API_URL=http://127.0.0.1:8000

# Bind the gateway to 0.0.0.0 so the Samsung Galaxy can reach it. Off by default.
ZERO_LAN_MODE=false

# Where the generated access token is stored (0600, outside the bundle).
ZERO_TOKEN_FILE=.zero/gateway-token

# Requests per minute per client address.
ZERO_RATE_LIMIT=240

# How long HWD-ZERO may take to answer the gateway's health probe.
ZERO_UPSTREAM_TIMEOUT_MS=1500

{
  "name": "brain-interface",
  "productName": "Brain Interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The visual, spoken 3D interface of HWD-ZERO.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gateway": "node server/gateway.mjs",
    "gateway:lan": "ZERO_LAN_MODE=true node server/gateway.mjs",
    "setup": "bash scripts/setup-zero.sh",
    "zero": "bash scripts/zero.sh",
    "zero:lan": "bash scripts/zero.sh --lan",
    "status": "bash scripts/status-zero.sh",
    "stop": "bash scripts/stop-zero.sh",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
